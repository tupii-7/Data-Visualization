        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy.stats import spearmanr\n",
        "\n",
        "print(\"=== 1. VERIFIKASI MATEMATIS KONSISTENSI SKOR D ===\")\n",
        "# Memeriksa selisih absolut antara D dan (Z_X - Z_Y)\n",
        "selisih_verifikasi = (df_mismatch['D'] - (df_mismatch['Z_X'] - df_mismatch['Z_Y'])).abs().max()\n",
        "print(f\"Selisih maksimum absolut hasil perhitungan D dengan (Z_X - Z_Y): {selisih_verifikasi:.2e}\")\n",
        "print(\"Status: Terverifikasi Konsisten Sempurna!\" if selisih_verifikasi < 1e-12 else \"Status: Terdapat perbedaan kecil!\")\n",
        "\n",
        "print(\"\\n=== 2. ANALISIS PERUBAHAN AKTUAL ADOPSI E-COMMERCE (2023 VS 2024) ===\")\n",
        "# Menghitung perubahan aktual (Delta = 2024 - 2023)\n",
        "data_analisis['Delta_E_Commerce'] = data_analisis['E_Commerce_2024'] - data_analisis['E_Commerce_2023']\n",
        "\n",
        "prov_meningkat = data_analisis[data_analisis['Delta_E_Commerce'] > 0]\n",
        "prov_menurun = data_analisis[data_analisis['Delta_E_Commerce'] < 0]\n",
        "n_valid_perubahan = data_analisis['Delta_E_Commerce'].dropna().count()\n",
        "\n",
        "print(f\"Jumlah Provinsi Teranalisis: {n_valid_perubahan} (2 provinsi baru Papua Tengah & Pegunungan tidak memiliki data 2023)\")\n",
        "print(f\"Jumlah Provinsi Mengalami Peningkatan Adopsi: {len(prov_meningkat)} ({len(prov_meningkat)/n_valid_perubahan*100:.1f}%)\")\n",
        "print(f\"Jumlah Provinsi Mengalami Penurunan Adopsi: {len(prov_menurun)} ({len(prov_menurun)/n_valid_perubahan*100:.1f}%)\")\n",
        "print(f\"Rata-rata Peningkatan Nasional: {data_analisis['Delta_E_Commerce'].mean():.2f}%\")\n",
        "print(f\"Peningkatan Terbesar: {data_analisis['Delta_E_Commerce'].max():.2f}% ({data_analisis.loc[data_analisis['Delta_E_Commerce'].idxmax(), 'Provinsi']})\")\n",
        "print(f\"Penurunan Terbesar: {data_analisis['Delta_E_Commerce'].min():.2f}% ({data_analisis.loc[data_analisis['Delta_E_Commerce'].idxmin(), 'Provinsi']})\")\n",
        "\n",
        "print(\"\\n=== 3. KORELASI SPEARMAN DENGAN INTERVAL KEPERCAYAAN 95% (BOOTSTRAP) ===\")\n",
        "def hitung_spearman_ci(df_input, var_ecc, var_tik, n_boot=1000, confidence_level=0.95):\n",
        "    df_clean = df_input[[var_ecc, var_tik]].dropna()\n",
        "    x = df_clean[var_ecc].values\n",
        "    y = df_clean[var_tik].values\n",
        "\n",
        "    # Nilai aktual\n",
        "    rho_actual, p_actual = spearmanr(x, y)\n",
        "\n",
        "    # Bootstrap untuk CI\n",
        "    boot_rhos = []\n",
        "    np.random.seed(42)\n",
        "    for _ in range(n_boot):\n",
        "        indices = np.random.choice(len(x), size=len(x), replace=True)\n",
        "        boot_rho, _ = spearmanr(x[indices], y[indices])\n",
        "        boot_rhos.append(boot_rho)\n",
        "\n",
        "    lower_alpha = (1 - confidence_level) / 2\n",
        "    upper_alpha = 1 - lower_alpha\n",
        "    ci_lower = np.quantile(boot_rhos, lower_alpha)\n",
        "    ci_upper = np.quantile(boot_rhos, upper_alpha)\n",
        "\n",
        "    return {\n",
        "        'Variabel': f\"{var_ecc} vs {var_tik}\",\n",
        "        'n': len(df_clean),\n",
        "        'Spearman rho': round(rho_actual, 4),\n",
        "        '95% CI': f\"[{ci_lower:.4f}, {ci_upper:.4f}]\",\n",
        "        'p-value': round(p_actual, 4)\n",
        "    }\n",
        "\n",
        "hasil_ci = []\n",
        "hasil_ci.append(hitung_spearman_ci(data_analisis, 'E_Commerce_2023', 'IP_TIK_2022'))\n",
        "hasil_ci.append(hitung_spearman_ci(data_analisis, 'E_Commerce_2024', 'IP_TIK_2023'))\n",
        "display(pd.DataFrame(hasil_ci))\n",
        "\n",
        "print(\"\\n=== 4. ANALISIS SENSITIVITAS AMBANG BATAS KLASIFIKASI D ===\")\n",
        "def uji_sensitivitas(df_mismatch, threshold):\n",
        "    mismatch_col = f'Klasifikasi_T_{threshold}'\n",
        "    def k_func(d):\n",
        "        if d > threshold:\n",
        "            return 'Akses TIK Tinggi'\n",
        "        elif d < -threshold:\n",
        "            return 'E-Commerce Tinggi'\n",
        "        else:\n",
        "            return 'Selaras'\n",
        "    return df_mismatch['D'].apply(k_func).value_counts()\n",
        "\n",
        "sens_df = pd.DataFrame({\n",
        "    'Threshold = 0.3': uji_sensitivitas(df_mismatch, 0.3),\n",
        "    'Threshold = 0.5 (Default)': uji_sensitivitas(df_mismatch, 0.5),\n",
        "    'Threshold = 0.7': uji_sensitivitas(df_mismatch, 0.7)\n",
        "}).fillna(0).astype(int)\n",
        "\n",
        "display(sens_df)"
      ],
