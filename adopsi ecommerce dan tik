        "import numpy as np\n",
        "import pandas as pd\n",
        "from scipy.stats import spearmanr\n",
        "\n",
        "# 1. Menyiapkan Data Kerja Gabungan (Simulasi IP-TIK & E-Commerce 2023)\n",
        "# Kami menggunakan daftar provinsi yang sama dari df_provinsi agar konsisten\n",
        "np.random.seed(42)\n",
        "n_prov = len(df_provinsi)\n",
        "\n",
        "data_analisis = df_provinsi[['Provinsi', 'E_Commerce_Persen']].copy()\n",
        "data_analisis.rename(columns={'E_Commerce_Persen': 'E_Commerce_2024'}, inplace=True)\n",
        "\n",
        "# Simulasi Data E-Commerce 2023 (dengan beberapa missing value untuk menunjukkan penanganan data kosong)\n",
        "data_analisis['E_Commerce_2023'] = data_analisis['E_Commerce_2024'] * np.random.uniform(0.8, 1.1, n_prov)\n",
        "data_analisis.loc[data_analisis['Provinsi'].isin(['Papua Tengah', 'Papua Pegunungan']), 'E_Commerce_2023'] = np.nan\n",
        "\n",
        "# Simulasi Indikator IP-TIK 2022\n",
        "data_analisis['Akses_2022'] = np.random.uniform(4.0, 9.0, n_prov)\n",
        "data_analisis['Penggunaan_2022'] = np.random.uniform(3.5, 8.5, n_prov)\n",
        "data_analisis['Keahlian_2022'] = np.random.uniform(4.5, 9.5, n_prov)\n",
        "data_analisis['IP_TIK_2022'] = data_analisis[['Akses_2022', 'Penggunaan_2022', 'Keahlian_2022']].mean(axis=1)\n",
        "\n",
        "# Simulasi Indikator IP-TIK 2023\n",
        "data_analisis['Akses_2023'] = data_analisis['Akses_2022'] + np.random.uniform(0.1, 0.5, n_prov)\n",
        "data_analisis['Penggunaan_2023'] = data_analisis['Penggunaan_2022'] + np.random.uniform(0.1, 0.5, n_prov)\n",
        "data_analisis['Keahlian_2023'] = data_analisis['Keahlian_2022'] + np.random.uniform(0.1, 0.5, n_prov)\n",
        "data_analisis['IP_TIK_2023'] = data_analisis[['Akses_2023', 'Penggunaan_2023', 'Keahlian_2023']].mean(axis=1)\n",
        "\n",
        "# 2. Fungsi untuk Menghitung Korelasi Spearman\n",
        "def hitung_spearman(df_input, var_ecc, var_tik, label):\n",
        "    # Hanya gunakan provinsi yang memiliki kedua data valid (pasangan lengkap)\n",
        "    df_clean = df_input[[var_ecc, var_tik]].dropna()\n",
        "    coef, p_val = spearmanr(df_clean[var_ecc], df_clean[var_tik])\n",
        "    return {\n",
        "        'Analisis': label,\n",
        "        'n_valid': len(df_clean),\n",
        "        'Koefisien Spearman (rho)': round(coef, 4),\n",
        "        'p-value': round(p_val, 4),\n",
        "        'Signifikan (alpha=0.05)': 'Ya' if p_val < 0.05 else 'Tidak'\n",
        "    }\n",
        "\n",
        "# 3. Menjalankan 6 Pengujian Terpisah + IP-TIK Total\n",
        "hasil_korelasi = []\n",
        "\n",
        "# Skenario 2023 vs TIK 2022\n",
        "hasil_korelasi.append(hitung_spearman(data_analisis, 'E_Commerce_2023', 'Akses_2022', 'E-Commerce 2023 vs Akses TIK 2022'))\n",
        "hasil_korelasi.append(hitung_spearman(data_analisis, 'E_Commerce_2023', 'Penggunaan_2022', 'E-Commerce 2023 vs Penggunaan TIK 2022'))\n",
        "hasil_korelasi.append(hitung_spearman(data_analisis, 'E_Commerce_2023', 'Keahlian_2022', 'E-Commerce 2023 vs Keahlian TIK 2022'))\n",
        "hasil_korelasi.append(hitung_spearman(data_analisis, 'E_Commerce_2023', 'IP_TIK_2022', 'E-Commerce 2023 vs IP-TIK Total 2022'))\n",
        "\n",
        "# Skenario 2024 vs TIK 2023\n",
        "hasil_korelasi.append(hitung_spearman(data_analisis, 'E_Commerce_2024', 'Akses_2023', 'E-Commerce 2024 vs Akses TIK 2023'))\n",
        "hasil_korelasi.append(hitung_spearman(data_analisis, 'E_Commerce_2024', 'Penggunaan_2023', 'E-Commerce 2024 vs Penggunaan TIK 2023'))\n",
        "hasil_korelasi.append(hitung_spearman(data_analisis, 'E_Commerce_2024', 'Keahlian_2023', 'E-Commerce 2024 vs Keahlian TIK 2023'))\n",
        "hasil_korelasi.append(hitung_spearman(data_analisis, 'E_Commerce_2024', 'IP_TIK_2023', 'E-Commerce 2024 vs IP-TIK Total 2023'))\n",
        "\n",
        "# Tampilkan Hasil Analisis\n",
        "df_hasil = pd.DataFrame(hasil_korelasi)\n",
        "display(df_hasil)"
      ],
