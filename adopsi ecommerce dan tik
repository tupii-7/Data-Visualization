        "import numpy as np\n",
        "\n",
        "# 1. Bersihkan data: Keluarkan baris agregat nasional ('Indonesia') agar tidak mengganggu statistik provinsi\n",
        "df_provinsi = df[df['Provinsi'].str.strip() != 'Indonesia'].copy()\n",
        "\n",
        "# 2. Ambil data e-commerce persen 2024\n",
        "y_2024 = df_provinsi['E_Commerce_Persen']\n",
        "\n",
        "# 3. Hitung metrik statistik\n",
        "mean_2024 = y_2024.mean()\n",
        "median_2024 = y_2024.median()\n",
        "\n",
        "# Min & Max beserta provinsinya\n",
        "idx_min = y_2024.idxmin()\n",
        "idx_max = y_2024.idxmax()\n",
        "prov_min = df_provinsi.loc[idx_min, 'Provinsi']\n",
        "val_min = df_provinsi.loc[idx_min, 'E_Commerce_Persen']\n",
        "prov_max = df_provinsi.loc[idx_max, 'Provinsi']\n",
        "val_max = df_provinsi.loc[idx_max, 'E_Commerce_Persen']\n",
        "\n",
        "range_2024 = val_max - val_min\n",
        "\n",
        "# IQR\n",
        "q1 = y_2024.quantile(0.25)\n",
        "q3 = y_2024.quantile(0.75)\n",
        "iqr_2024 = q3 - q1\n",
        "\n",
        "# Simpangan baku dan CV\n",
        "std_2024 = y_2024.std()\n",
        "cv_2024 = (std_2024 / mean_2024) * 100\n",
        "\n",
        "# 4. Tampilkan hasil analisis statistik deskriptif\n",
        "print(\"=== ANALISIS DESKRIPTIF & DISPARITAS E-COMMERCE 2024 ===\")\n",
        "print(f\"Jumlah Observasi (n)     : {len(df_provinsi)} provinsi\")\n",
        "print(f\"Rata-rata                : {mean_2024:.2f}%\")\n",
        "print(f\"Median                   : {median_2024:.2f}%\")\n",
        "print(f\"Minimum                  : {val_min:.2f}% ({prov_min})\")\n",
        "print(f\"Maksimum                 : {val_max:.2f}% ({prov_max})\")\n",
        "print(f\"Rentang (Range)          : {range_2024:.2f}%\")\n",
        "print(f\"Interquartile Range (IQR): {iqr_2024:.2f}%\")\n",
        "print(f\"Simpangan Baku (s)       : {std_2024:.2f}%\")\n",
        "print(f\"Koefisien Variasi (CV)   : {cv_2024:.2f}%\")"
      ],
