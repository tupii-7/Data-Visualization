      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Atur style visualisasi\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "plt.figure(figsize=(12, 16))\n",
        "\n",
        "# Menyusun dataframe untuk plotting\n",
        "df_sorted = data_analisis.sort_values(by='E_Commerce_2024', ascending=False).copy()\n",
        "df_melted = df_sorted.melt(id_vars=['Provinsi'], value_vars=['E_Commerce_2023', 'E_Commerce_2024'],\n",
        "                               var_name='Tahun', value_name='Persentase')\n",
        "df_melted['Tahun'] = df_melted['Tahun'].map({'E_Commerce_2023': '2023', 'E_Commerce_2024': '2024'})\n",
        "\n",
        "# Menggambar diagram batang kelompok horizontal\n",
        "ax = sns.barplot(\n",
        "    data=df_melted,\n",
        "    y='Provinsi',\n",
        "    x='Persentase',\n",
        "    hue='Tahun',\n",
        "    palette=['#3498db', '#e74c3c'],\n",
        "    edgecolor='black',\n",
        "    linewidth=0.5\n",
        ")\n",
        "\n",
        "# Memberikan label khusus untuk Papua Tengah dan Papua Pegunungan yang tidak memiliki data 2023\n",
        "for i, provinsi in enumerate(df_sorted['Provinsi']):\n",
        "    if provinsi in ['Papua Tengah', 'Papua Pegunungan']:\n",
        "        # Letakkan teks keterangan di sebelah baris provinsi yang bersangkutan\n",
        "        ax.text(\n",
        "            x=3.5,\n",
        "            y=i + 0.15,\n",
        "            s=\"* 2023: No Data (Provinsi Baru)\",\n",
        "            color='#c0392b',\n",
        "            va='center',\n",
        "            ha='left',\n",
        "            fontweight='bold',\n",
        "            fontsize=9\n",
        "        )\n",
        "\n",
        "# Kustomisasi estetika grafik\n",
        "plt.title(\"PERBANDINGAN ADOPSI E-COMMERCE PROVINSI DI INDONESIA\\nTAHUN 2023 VS 2024\", fontsize=14, fontweight='bold', pad=15)\n",
        "plt.xlabel(\"Persentase Adopsi E-Commerce (%)\", fontsize=11, labelpad=10)\n",
        "plt.ylabel(\"Provinsi\", fontsize=11)\n",
        "plt.xlim(0, 75)\n",
        "plt.legend(title=\"Tahun Data\", loc='lower right', frameon=True, facecolor='white', edgecolor='gray')\n",
        "plt.tight_layout()\n",
        "plt.show()"
