        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# 1. Menentukan variabel berpasangan (misalnya Akses TIK 2023 sebagai X dan E-Commerce 2024 sebagai Y)\n",
        "# Pastikan kita menyaring data dari unit analisis yang memiliki kedua data lengkap\n",
        "df_mismatch = data_analisis[['Provinsi', 'Akses_2023', 'E_Commerce_2024']].dropna().copy()\n",
        "\n",
        "# 2. Menghitung Z-Score secara konsisten dalam sampel\n",
        "mean_X = df_mismatch['Akses_2023'].mean()\n",
        "std_X = df_mismatch['Akses_2023'].std()\n",
        "df_mismatch['Z_X'] = (df_mismatch['Akses_2023'] - mean_X) / std_X\n",
        "\n",
        "mean_Y = df_mismatch['E_Commerce_2024'].mean()\n",
        "std_Y = df_mismatch['E_Commerce_2024'].std()\n",
        "df_mismatch['Z_Y'] = (df_mismatch['E_Commerce_2024'] - mean_Y) / std_Y\n",
        "\n",
        "# 3. Menghitung Skor Ketidakselarasan (D)\n",
        "df_mismatch['D'] = df_mismatch['Z_X'] - df_mismatch['Z_Y']\n",
        "\n",
        "# 4. Melakukan klasifikasi sederhana berdasarkan skor D\n",
        "def klasifikasi_mismatch(d):\n",
        "    if d > 0.5:\n",
        "        return 'Akses TIK Relatif Lebih Tinggi (D > 0.5)'\n",
        "    elif d < -0.5:\n",
        "        return 'E-Commerce Relatif Lebih Tinggi (D < -0.5)'\n",
        "    else:\n",
        "        return 'Relatif Selaras'\n",
        "\n",
        "df_mismatch['Klasifikasi'] = df_mismatch['D'].apply(klasifikasi_mismatch)\n",
        "\n",
        "# Urutkan berdasarkan nilai D terbesar untuk melihat ketidakselarasan paling ekstrem\n",
        "df_mismatch = df_mismatch.sort_values(by='D', ascending=False)\n",
